# Copie para .env e preencha localmente. Nunca envie tokens pelo chat ou pelo Git.
# Manter vazio enquanto o numero do salao nao estiver definido.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Versao Graph suportada pela conta, no formato vNN.N. Sem versao presumida.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_BIRTHDAY=
# messages para Cloud API; marketing_messages somente quando habilitado na conta.
WHATSAPP_BIRTHDAY_ENDPOINT=messages
# Origem HTTPS da hospedagem futura, sem barra final ou caminho.
PUBLIC_ORIGIN=
# Em HTTPS, ativar cookies Secure. Manter 0 somente para o desenvolvimento local HTTP.
COOKIE_SECURE=0
